# API
ADS_GROWTH_ENV=local
ADS_GROWTH_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://ads_growth:ads_growth@localhost:5432/ads_growth
TENANT_ID=default
KNOWLEDGE_STORE_BACKEND=memory
RUN_PERSISTENCE_BACKEND=none
CAMPAIGN_DRAFT_PERSISTENCE_BACKEND=none
IDEMPOTENCY_BACKEND=none
IDEMPOTENCY_TTL_SECONDS=86400
POSTGRES_DB=ads_growth
POSTGRES_USER=ads_growth
POSTGRES_PASSWORD=ads_growth

# LiteLLM Proxy
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-dev-key
LITELLM_API_KEY=sk-local-dev-key
DEFAULT_CHAT_MODEL=openai/gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=openai/text-embedding-3-small
USE_LLM_PLANNER=false
USE_LLM_CRITIC=false
LLM_STRUCTURED_OUTPUT_MAX_REPAIR_ATTEMPTS=1
LLM_CRITIC_MIN_SCORE=7.0
MAX_REVISION_ATTEMPTS=1
KNOWLEDGE_TOP_K=3

# Model provider credentials
OPENAI_API_KEY=replace-me

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ads-growth-agent-local
